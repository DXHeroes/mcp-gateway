# Settings for compose.yaml. The Quick Start in README.md writes this file for you.

# Accepts the CE distribution terms. Read LICENSE-CE.txt, then set the version it names.
GATEWAY_CE_TERMS_ACCEPTED=

# Generate each secret separately and keep this file: without GATEWAY_ENCRYPTION_KEY the
# credentials stored in the database cannot be decrypted.
# openssl rand -hex 32 (hex, because the password becomes part of the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=

# The address users open. Change it together with a TLS reverse proxy.
PUBLIC_URL=http://localhost:3001
# Switch to invite_only once the first account (the owner) exists.
AUTH_SIGNUP_MODE=open

# Optional: a different image, e.g. ghcr.io/dxheroes/mcp-gateway-ce:<tag>, or a digest pin
# (image@sha256:…) from release.json. Unset uses the image named in compose.yaml.
# GATEWAY_IMAGE=
