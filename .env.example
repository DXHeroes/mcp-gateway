# Set to the exact CE image and digest from release.json.
# Example: ghcr.io/dxheroes/mcp-gateway-ce@sha256:...
GATEWAY_IMAGE=
PUBLIC_URL=http://localhost:3001
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
GATEWAY_ENCRYPTION_KEY=
# Complete only after an administrator has read LICENSE-CE.txt.
GATEWAY_CE_TERMS_ACCEPTED=
GATEWAY_CE_USE=
AUTH_SIGNUP_MODE=open
